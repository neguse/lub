<Project>
  <!-- Imported by projects that reference TinySystem. Points Math / MathF in code
       to TinySystem.Math so that, even when running on .NET, transcendental functions (Sin / Pow, etc.)
       return the same results as tcs C and VM, bit for bit (TCS1004) -->
  <ItemGroup>
    <Using Include="TinySystem.Math" Alias="Math" />
    <Using Include="TinySystem.Math" Alias="MathF" />
  </ItemGroup>
  <!-- TinySystem.Linq (LINQ for List<T>) is shipped as source. .NET also compiles the same file that tcs converts
       into C / VM IL -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Linq.cs" Link="TinySystem\Linq.cs" Visible="false" />
  </ItemGroup>
  <!-- Makes Dictionary / HashSet use the implementation of the tcs spec (enumeration in insertion order; support-matrix §18). Source types hide the BCL types of the same
       name (CS0436 is suppressed) -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Collections.cs" Link="TinySystem\Collections.cs" Visible="false" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <!-- Makes the default string comparison (List.Sort / OrderBy / Min / Max) culture-independent ordinal, giving the same order as tcs C and VM -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
