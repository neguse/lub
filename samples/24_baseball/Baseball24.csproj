<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# entry for lub, also the project for IDEs.
       lub does not evaluate this file as MSBuild; it reads only the basename (= entry class)
       and the *.cs files under the same directory: lub samples/24_baseball/Baseball24.csproj
       On the dotnet side (Rider / VS Code), this csproj provides type checking, completion and TCS diagnostics. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- .lub holds the generated files of lub. Excluded from compile -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../cs-lib/lub_stub.cs" Link="lub_stub.cs" />
    <!-- cs-lib implementation sources (lubx/*) are compile inputs of every sample (same convention as the lub CLI) -->
    <Compile Include="../../cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(TcsRoot)/TinySystem/TinySystem.csproj" />
    <ProjectReference Include="$(TcsRoot)/TinyCs.Analyzers/TinyCs.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
