<Project Sdk="Microsoft.NET.Sdk">
  <!-- lub の C# entry 兼 IDE 用プロジェクト。
       lub はこのファイルを MSBuild としては評価せず、basename (= entry class)
       と同ディレクトリの *.cs だけを読む: lub samples/20_audio/AudioLab20.csproj
       dotnet 側 (Rider / VS Code) はこの csproj で型チェック・補完・TCS 診断が効く。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- 生成物はチェック専用 (実行は Lua 側)。.lub を compile 対象から外す -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../cs-lib/lub_stub.cs" Link="lub_stub.cs" />
    <!-- cs-lib 実装ソース (lubx/*) は全サンプルの compile 入力 (lub CLI と同じ規約) -->
    <Compile Include="../../cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../../third_party/tcs/TinySystem/TinySystem.csproj" />
    <ProjectReference Include="../../third_party/tcs/TinyCs.Analyzers/TinyCs.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
