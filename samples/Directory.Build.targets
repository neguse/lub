<Project>
  <!-- Common to every csproj in samples (for IDE type checking): the declarations of the lub API put into Compile (lub_stub.cs)
       are read as a tcs ref by the TinyC# analyzer (the same compiler as tcs check). lub also passes this file as a ref -->
  <ItemGroup>
    <Compile Update="$(MSBuildThisFileDirectory)../cs-lib/lub_stub.cs" TinyCsRef="true" />
    <CompilerVisibleItemMetadata Include="Compile" MetadataName="TinyCsRef" />
  </ItemGroup>
</Project>
