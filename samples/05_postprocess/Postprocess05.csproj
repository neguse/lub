<Project Sdk="Microsoft.NET.Sdk">
  <!-- lub C# entry and IDE project.
       lub does not evaluate this file as MSBuild, and reads only the basename (= entry class)
       and the *.cs files in the same directory and below: lub samples/05_postprocess/Postprocess05.csproj
       On the dotnet side (Rider / VS Code), this csproj enables type checking, completion, and TCS diagnostics. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- .lub is where lub puts its generated files. Excluded from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../cs-lib/lub_stub.cs" Link="lub_stub.cs" />
    <!-- The cs-lib implementation sources (lubx/*) are compile inputs of all samples (same convention as the lub CLI) -->
    <Compile Include="../../cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(LubRoot)/src/tcs-system/tcs-system.csproj" />
    <ProjectReference Include="$(LubRoot)/src/tcs-analyzers/tcs-analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
