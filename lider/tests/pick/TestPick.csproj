<Project Sdk="Microsoft.NET.Sdk">
  <!-- Includes the lider sources and runs lider from the test entry. The dotnet side sees the lub types and the lider types from the lider assembly -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lider.csproj" Lub="Source" />
  </ItemGroup>
</Project>
