<Project Sdk="Microsoft.NET.Sdk">
  <!-- Includes lider's sources and runs lider from the test entry. The dotnet side sees lub's types and lider's types through the lider assembly -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lider.csproj" Lub="Source" />
  </ItemGroup>
</Project>
