<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app that TestAlloc.cs opens with App.Use (the entry is TestAllocProbe). It includes lider's sources and calls lider's search and drawing. The dotnet side sees lub's types and lider's types through the lider assembly -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Lider.csproj" Lub="Source" />
  </ItemGroup>
</Project>
