<Project Sdk="Microsoft.NET.Sdk">
  <!-- The test entry. It does not run lider; it opens TestAllocProbe.csproj with App.Use. It references lider because TestAllocProbe.cs in the same directory uses lider's types, and this entry loads the lider native extension used by the opened app -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lider.csproj" Lub="Source" />
  </ItemGroup>
</Project>
