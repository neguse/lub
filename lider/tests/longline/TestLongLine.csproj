<Project Sdk="Microsoft.NET.Sdk">
  <!-- lider のソースを取り込み、test の entry から lider を動かす。dotnet 側は lider の assembly から lub の型と lider の型を見る -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lider.csproj" Lub="Source" />
  </ItemGroup>
</Project>
