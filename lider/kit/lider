#!/bin/sh
# Launches lider from the release bundle (Linux and macOS).
#   lub/bin/lider [Game.csproj] [lub player args...]
# When Game.csproj is given, lider opens that game (env LIDER_GAME).
# lider's files (Lider.tcsb, fonts, the kana-kanji conversion dictionary) are read from lider/ in the bundle (env LIDER_HOME).
set -e
bin="$(cd "$(dirname "$0")" && pwd)"
kit="$(dirname "$bin")"
case "${1:-}" in
  *.csproj)
    game="$1"
    shift
    case "$game" in
      /*) ;;
      *) game="$PWD/$game" ;;
    esac
    export LIDER_GAME="$game"
    ;;
esac
export LIDER_HOME="${LIDER_HOME:-$kit/lider}"
exec "$bin/lider-player" "$kit/lider/Lider.tcsb" "$@"
