<Project Sdk="Microsoft.NET.Sdk">
  <!-- lub のゲームの雛形。lub にとっては entry 指定 (basename = entry class、
       入力 = このディレクトリ以下の *.cs) で、dotnet にとっては .NET 実行の
       project。LubRoot は lub の checkout (cp -r で外に出したら書き換える)。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace></RootNamespace>
    <LubRoot Condition="'$(LubRoot)' == ''">$(MSBuildThisFileDirectory)../..</LubRoot>
    <!-- lub の release build に含まれる共有 library の場所 -->
    <LubNativeDir Condition="'$(LubNativeDir)' == ''">$(LubRoot)/build-release-linux</LubNativeDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
  <!-- tcs の場所 ($(TcsRoot))。lub の checkout の中では Directory.Build.props が先に読んでいる -->
  <Import Project="$(LubRoot)/Lub.props" Condition="'$(TcsRoot)' == ''" />

  <ItemGroup>
    <!-- cs-lib の実装ソース (lub.Math、lubx) は tcs VM の player と同じく compile に含める -->
    <Compile Include="$(LubRoot)/cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(LubRoot)/cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(LubRoot)/dotnet/Lub/Lub.csproj" />
    <ProjectReference Include="$(TcsRoot)/TinySystem/TinySystem.csproj" />
    <ProjectReference Include="$(TcsRoot)/TinyCs.Analyzers/TinyCs.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <!-- TinyC# の analyzer (tcs check と同じ compiler) に lub の API の宣言を tcs の ref として渡す -->
    <AdditionalFiles Include="$(LubRoot)/cs-lib/lub_stub.cs" TinyCsRef="true" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="TinyCsRef" />
    <!-- 共有 library を出力の隣に置く (DllImport の既定の探索で見つかる) -->
    <None Include="$(LubNativeDir)/liblub.so" Condition="Exists('$(LubNativeDir)/liblub.so')"
          CopyToOutputDirectory="PreserveNewest" Link="liblub.so" />
    <None Include="$(LubNativeDir)/lub.dll" Condition="Exists('$(LubNativeDir)/lub.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="lub.dll" />
  </ItemGroup>
  <!-- Math / MathF を TinySystem.Math にし、.NET 実行でも Math の超越関数を
       tcs VM / tcs2c と bit 単位で同じ結果にする -->
  <Import Project="$(TcsRoot)/TinySystem/TinySystem.props" />
</Project>
