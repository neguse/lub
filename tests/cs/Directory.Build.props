<Project>
  <!-- Settings shared by the csproj of each test in tests/cs (<Entry>.csproj, which is empty).
       lub does not evaluate the csproj as MSBuild; it reads only the basename (= entry class) and
       the *.cs under this directory: lub tests/cs/TestBitMask.csproj
       On the dotnet side (IDE), type checking, completion, and TCS diagnostics work here. -->
  <Import Project="../../Lub.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../cs-lib/lub_stub.cs" Link="lub_stub.cs" />
    <Compile Include="../../cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(TcsRoot)/TinySystem/TinySystem.csproj" />
    <ProjectReference Include="$(TcsRoot)/TinyCs.Analyzers/TinyCs.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <!-- Maps Math / MathF to TinySystem.Math (the same implementation as tcs VM / tcs2c) -->
  <Import Project="$(TcsRoot)/TinySystem/TinySystem.props" />
</Project>
