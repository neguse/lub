<Project>
  <!-- tests/cs の各 test の csproj (<Entry>.csproj、中身は空) に共通の設定。
       lub は csproj を MSBuild として評価せず、basename (= entry class) と
       このディレクトリ以下の *.cs だけを読む: lub tests/cs/TestBitMask.csproj
       dotnet 側 (IDE) はここで型チェック・補完・TCS 診断が効く。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);.lub/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../cs-lib/lub_stub.cs" Link="lub_stub.cs" />
    <Compile Include="../../cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../../third_party/tcs/TinySystem/TinySystem.csproj" />
    <ProjectReference Include="../../third_party/tcs/TinyCs.Analyzers/TinyCs.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <!-- Math / MathF を TinySystem.Math (tcs2c / Lua と同じ実装) にする -->
  <Import Project="../../third_party/tcs/TinySystem/TinySystem.props" />
</Project>
