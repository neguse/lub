<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TinyCs.Tcs2c.Tests</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The .NET oracle: reads test input as C# and runs it on .NET -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Input of the C-only checks (verify-*.sh) -->
    <Compile Remove="c/**/*.cs" />
    <None Include="c/**/*.cs" />
    <Compile Include="..\tcs\SpecConformance\FuzzReloadGenerator.cs" Link="FuzzReloadGenerator.cs" />
    <Compile Include="..\tcs\SpecConformance\FuzzGenerator*.cs" LinkBase="FuzzGenerator" />
    <!-- The .NET entries to the compiler and the VM backend, the same ones as tests/tcs -->
    <Compile Include="..\tcs\Entry\IlExport.cs;..\tcs\Entry\SelfHostVm.cs;..\tcs\Entry\VmSession.cs" LinkBase="Entry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\tcs\tcs.csproj" />
    <ProjectReference Include="..\..\src\tcs-system\tcs-system.csproj" />
  </ItemGroup>

</Project>
