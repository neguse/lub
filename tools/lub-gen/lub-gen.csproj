<Project Sdk="Microsoft.NET.Sdk">
  <!-- lub API の記述 (cs-lib/lub_stub.cs) を Roslyn で読み、面の検査と生成物を
       作る generator。名前の写像規則は tcs の LuaNaming をそのまま使う。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LubGen</RootNamespace>
    <AssemblyName>lub-gen</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../third_party/tcs/Transpiler/Transpiler.csproj" />
  </ItemGroup>
</Project>
