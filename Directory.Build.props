<Project>
  <!-- lub の .NET の project (dotnet/、tools/lub-gen、tests/dotnet、templates/game) に共通: 警告は build を止める。
       native gate と release が build する所がそのまま gate になる。NuGet の脆弱性の監査 (NU1900〜NU1904) は
       助言の公開でいつでも増え、コードの誤りではないので警告のままにする。
       samples/ (IDE の型検査用) は自分の Directory.Build.props を持つのでこれを読まない。tcs も同じ設定を自分で持つ -->
  <Import Project="$(MSBuildThisFileDirectory)Lub.props" />
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
