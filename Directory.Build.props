<Project>
  <!-- Common to lub's .NET projects (dotnet/, tools/lub-gen, tests/dotnet, templates/game, tcs/): warnings stop the build.
       So whatever the native gate and release build acts directly as a gate. The NuGet vulnerability audit (NU1900 to NU1904)
       can grow at any time as advisories are published and is not a code error, so it stays a warning.
       samples/ (for IDE type checking) has its own Directory.Build.props and does not read this one -->
  <Import Project="$(MSBuildThisFileDirectory)Lub.props" />
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- Only the projects under tcs/ use NuGet packages. Each records the resolved versions in packages.lock.json.
       CI fails a restore that would resolve anything else; a local restore updates the file, which is committed with the version change -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tcs'))">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
