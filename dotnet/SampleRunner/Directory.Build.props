<Project>
  <!-- Also read the repo's Directory.Build.props (turns warnings into errors) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Separate intermediate output per sample (the same project is built with different Sample values).
       BaseIntermediateOutputPath must be set before the SDK props (NuGet restore), so it lives here rather than in the csproj -->
  <PropertyGroup>
    <Sample Condition="'$(Tests)' == 'true'">tests</Sample>
    <Sample Condition="'$(Sample)' == ''">00_hello</Sample>
    <BaseIntermediateOutputPath>obj/$(Sample)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
