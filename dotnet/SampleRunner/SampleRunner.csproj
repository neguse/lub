<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runner that runs the samples with .NET execution (for the native gate / CI).
       dotnet run -p:Sample=09_breakout ‐‐project dotnet/SampleRunner (‐‐ is actually two ASCII hyphens).
       Compiles the *.cs in the Sample directory and the implementation sources in cs-lib, and App.Run finds the entry class (the class with a static OnFrame).
       -p:Tests=true builds all *.cs in tests/cs (the same input as the tcs VM's tests/cs/.lub/all.tcsb) into one executable (bin/tests/lub-sample-tests), and the test is chosen with the launch argument ‐‐entry <Entry>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>lub-sample-$(Sample)</AssemblyName>
    <RootNamespace></RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>
    <!-- Separate output directory per sample (Sample and the intermediate output are in Directory.Build.props) -->
    <OutputPath>bin/$(Sample)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Warnings in tests/cs are checked by tcs check (cs_tests_check in scripts/cs-tests.sh) and the IDE (the tests/cs project), so .NET warnings are not emitted here -->
    <WarningLevel Condition="'$(Tests)' == 'true'">0</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../samples/$(Sample)/*.cs" Link="sample/%(Filename)%(Extension)" Condition="'$(Tests)' != 'true'" />
    <!-- Like cs_tests_sources in scripts/cs-tests.sh, excludes bin, obj, and directories starting with . -->
    <Compile Include="../../tests/cs/**/*.cs" Exclude="../../tests/cs/**/bin/**;../../tests/cs/**/obj/**;../../tests/cs/**/.*/**" Link="test/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(Tests)' == 'true'" />
    <Compile Include="../../cs-lib/lubx/**/*.cs" Link="lubx/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../cs-lib/lub/**/*.cs" Link="lub/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="../Lub/Lub.csproj" />
    <ProjectReference Include="$(LubRoot)/src/tcs-system/tcs-system.csproj" />
  </ItemGroup>
  <!-- Maps Math / MathF to TinySystem.Math (the same implementation as tcs VM / tcs2c) -->
  <Import Project="$(LubRoot)/src/tcs-system/tcs-system.props" />
</Project>
