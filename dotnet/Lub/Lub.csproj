<Project Sdk="Microsoft.NET.Sdk">
  <!-- lub .NET execution: the facade and host for the C API (shared library liblub / lub.dll).
       Lub.g.cs is generated code from cs-lib/lub_stub.cs (scripts/gen-api.sh).
       Games reference this project and include cs-lib/lub and cs-lib/lubx
       in the compile (templates/game/Game.csproj). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace></RootNamespace>
    <AssemblyName>Lub</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
