# Read by find_package(lub). Points to a lub build tree (lub_DIR).
# lub::lub_vm_player: the tcs VM player library (include/lub/lub_vm.h).
# lub_vm_player_link_options(<target> <output directory>): settings for the web executable.
set(LUB_HAS_VULKAN @LUB_HAS_VULKAN@)
if(LUB_HAS_VULKAN AND NOT TARGET Vulkan::Vulkan)
  find_package(Vulkan REQUIRED)
endif()
# Third-party libraries are searched for in <build>/deps/ created by the lub build (cmake/LubDeps.cmake).
set(_lub_deps_prefix "@LUB_DEPS_PREFIX@")
if(NOT TARGET SDL3::SDL3)
  find_package(SDL3 REQUIRED CONFIG PATHS "${_lub_deps_prefix}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()
if(NOT TARGET box2d::box2d)
  find_package(box2d REQUIRED CONFIG PATHS "${_lub_deps_prefix}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()
if(NOT TARGET box3d::box3d)
  find_package(box3d REQUIRED CONFIG PATHS "${_lub_deps_prefix}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()
set(LUB_HAS_OPENXR @LUB_HAS_OPENXR@)
if(LUB_HAS_OPENXR AND NOT TARGET OpenXR::openxr_loader)
  find_package(OpenXR REQUIRED CONFIG PATHS "${_lub_deps_prefix}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/lubTargets.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/cmake/LubVmPlayer.cmake")
