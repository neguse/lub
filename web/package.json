{
  "name": "lub-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run gen-api && npm run gen-lider && vite",
    "build": "npm run gen-api && npm run gen-lider && vite build",
    "gen-api": "node scripts/gen-api-docs.mjs",
    "gen-lider": "bash ../lider/scripts/build-module.sh ../lider/build/web/Lider.tcsb",
    "preview": "vite preview",
    "fetch-slang": "bash scripts/fetch-slang-wasm.sh",
    "gen-tcs": "node scripts/gen-tcs-assets.mjs",
    "verify": "node scripts/verify-player.mjs",
    "verify-lider": "node scripts/verify-lider.mjs",
    "golden": "node scripts/golden-web.mjs",
    "format": "prettier --write 'lider/**/*.ts' 'player/**/*.ts' 'docs/**/*.ts' 'lib/**/*.ts' vite.config.ts",
    "format:check": "prettier --check 'lider/**/*.ts' 'player/**/*.ts' 'docs/**/*.ts' 'lib/**/*.ts' vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "npm run fetch-slang"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "markdown-it": "^14.3.3",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.3.0",
    "vite": "^8.1.6",
    "wrangler": "^4.155.0"
  }
}
