{
  "name": "lub-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run gen-api && vite",
    "build": "npm run gen-api && vite build",
    "gen-api": "node scripts/gen-api-docs.mjs",
    "preview": "vite preview",
    "fetch-slang": "bash scripts/fetch-slang-wasm.sh",
    "gen-haxe": "node scripts/gen-haxe-assets.mjs",
    "gen-tcs": "node scripts/gen-tcs-assets.mjs",
    "gen-tcs-prebuilt": "node scripts/gen-tcs-prebuilt.mjs",
    "verify": "node scripts/verify-headless.mjs",
    "golden": "node scripts/golden-web.mjs",
    "format": "prettier --write 'playground/**/*.ts' vite.config.ts",
    "format:check": "prettier --check 'playground/**/*.ts' vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "postinstall": "npm run fetch-slang"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.10.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "fast-xml-parser": "^5.10.1",
    "markdown-it": "^14.3.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.3.0",
    "vite": "^8.0.13",
    "wrangler": "^4.127.1"
  }
}
