<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <TcsRoot Condition="'$(TcsRoot)' == ''">..</TcsRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <ProjectReference Include="$(TcsRoot)/Transpiler/Transpiler.csproj"
                      GlobalPropertiesToRemove="TcsRoot" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tcs2c.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(TcsRoot)/runtime/math/*.h;$(TcsRoot)/runtime/math/*.c"
                      LogicalName="math/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TcsRoot)/runtime/fmt/*.h;$(TcsRoot)/runtime/fmt/*.c"
                      LogicalName="fmt/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(TcsRoot)/runtime/utf8/*.h;$(TcsRoot)/runtime/utf8/*.c"
                      LogicalName="utf8/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
