<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Runs the in-process .NET oracles (SpecDotnetExecutor / VmCorpus) on a .NET whose default string comparison is ordinal, the same as TinySystem.props -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The digest kernel (T215) is transpile input data,
         not source of the test assembly (its Main would collide as an entry point) -->
    <Compile Remove="DigestKernels/**/*.cs" />
    <None Include="DigestKernels/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transpiler\Transpiler.csproj" />
    <ProjectReference Include="..\SelfHost\SelfHost.csproj" />
    <ProjectReference Include="..\tcsvm\Emitter\tcs2vm.csproj" />
  </ItemGroup>

  <!-- Reference assemblies read only when building the BCL name table (BclCatalogTests) (not added to the compiler's references) -->
  <Target Name="EmbedCatalogReferences" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveFrameworkReferences">
    <PropertyGroup>
      <_CatalogRefDir>@(ResolvedTargetingPack->WithMetadataValue('NuGetPackageId', 'Microsoft.NETCore.App.Ref')->'%(Path)')/ref/net11.0</_CatalogRefDir>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(_CatalogRefDir)/System.Threading.Thread.dll" LogicalName="catalog/System.Threading.Thread.dll" />
      <EmbeddedResource Include="$(_CatalogRefDir)/System.Linq.Expressions.dll" LogicalName="catalog/System.Linq.Expressions.dll" />
      <EmbeddedResource Include="$(_CatalogRefDir)/System.Net.Sockets.dll" LogicalName="catalog/System.Net.Sockets.dll" />
      <EmbeddedResource Include="$(_CatalogRefDir)/System.Net.Primitives.dll" LogicalName="catalog/System.Net.Primitives.dll" />
    </ItemGroup>
  </Target>

</Project>
