<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <!-- The tcs host (TinyC#). DotnetHost.cs implements it instead of the OS function stub (TcsHost.cs) -->
    <Compile Include="..\..\src\tcs\Tool\*.cs" Exclude="..\..\src\tcs\Tool\TcsHost.cs" LinkBase="Tool" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinySystem\TinySystem.csproj" />
    <!-- The compiler itself (the self-host implementation) -->
    <ProjectReference Include="..\SelfHost\SelfHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime C that `tcs c` (C backend) embeds in the generated C -->
    <Content Include="..\..\src\tcs-runtime\core\*.c;..\..\src\tcs-runtime\core\*.h" LinkBase="runtime\core" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\src\tcs-runtime\math\*.c;..\..\src\tcs-runtime\math\*.h" LinkBase="runtime\math" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\src\tcs-runtime\fmt\*.c;..\..\src\tcs-runtime\fmt\*.h" LinkBase="runtime\fmt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\src\tcs-runtime\model\*.c;..\..\src\tcs-runtime\model\*.h" LinkBase="runtime\model" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\src\tcs-runtime\utf8\*.c;..\..\src\tcs-runtime\utf8\*.h" LinkBase="runtime\utf8" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="EmbedReferences.targets" />

</Project>
