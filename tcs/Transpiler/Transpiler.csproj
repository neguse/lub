<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <!-- tcs の host (TinyC#)。OS の関数の stub (TcsHost.cs) の代わりに DotnetHost.cs が実装する -->
    <Compile Include="..\SelfHost\Tool\*.cs" Exclude="..\SelfHost\Tool\TcsHost.cs" LinkBase="Tool" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinySystem\TinySystem.csproj" />
    <!-- compiler の本体 (セルフホストの実装) -->
    <ProjectReference Include="..\SelfHost\SelfHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `tcs c` (C backend) が生成 C に埋め込む runtime の C -->
    <Content Include="..\runtime\core\*.c;..\runtime\core\*.h" LinkBase="runtime\core" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\runtime\math\*.c;..\runtime\math\*.h" LinkBase="runtime\math" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\runtime\fmt\*.c;..\runtime\fmt\*.h" LinkBase="runtime\fmt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\runtime\model\*.c;..\runtime\model\*.h" LinkBase="runtime\model" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\runtime\utf8\*.c;..\runtime\utf8\*.h" LinkBase="runtime\utf8" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="EmbedReferences.targets" />

</Project>
