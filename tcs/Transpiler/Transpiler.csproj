<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinySystem\TinySystem.csproj" />
    <!-- 単一の実装へ移す途中: サブセットに写した IL の emit (SelfHost/Compiler/LuaGen.cs) と出力を比べる (TCS_LUAGEN_CHECK=1) -->
    <ProjectReference Include="..\SelfHost\SelfHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\runtime\tinysystem.lua" Link="runtime\tinysystem.lua" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\runtime\module_registry.lua" Link="runtime\module_registry.lua" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="EmbedReferences.targets" />

</Project>
