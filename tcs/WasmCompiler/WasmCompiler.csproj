<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <!-- The JSExport source generator requires unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Drop ICU data to reduce download size (culture data is not needed for compiler use) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn's localized diagnostic resources affect download size, so English only -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- IL2104 aggregates trim warnings inside Roslyn (Microsoft.CodeAnalysis, an external assembly) and cannot be fixed here.
         Trim problems in our own code are made errors by the build analysis (IL2026 etc.) -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Disable fingerprinting so the worker can import from a stable URL
         (gen-tcs-assets.mjs on the lub side handles cache busting at the copy destination) -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharpier.Core" Version="1.2.6" />
  </ItemGroup>
</Project>
