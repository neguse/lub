<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <!-- The JSExport source generator requires unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Drop ICU data to reduce download size (culture data is not needed for compiler use) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn's localized diagnostic resources affect download size, so English only -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- IL2104 aggregates trim warnings inside Roslyn (Microsoft.CodeAnalysis, an external assembly) and cannot be fixed here.
         Trim problems in our own code are made errors by the build analysis (IL2026 etc.) -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Disable fingerprinting so the worker can import from a stable URL
         (gen-tcs-assets.mjs on the lub side handles cache busting at the copy destination) -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transpiler is an Exe project, so it cannot be a ProjectReference (NETSDK1150).
         The core sources are included directly (excluding Program.cs, the CLI entry) -->
    <Compile Include="../Transpiler/*.cs" Exclude="../Transpiler/Program.cs" />
    <Compile Include="../Shared/*.cs" />
    <Compile Include="../SelfHost/Tool/*.cs" Exclude="../SelfHost/Tool/TcsHost.cs" />
    <!-- Entry point of the VM emitter (used by VmExports; excluding Program.cs, the CLI entry) -->
    <Compile Include="../tcsvm/Emitter/*.cs" Exclude="../tcsvm/Emitter/Program.cs" />
    <ProjectReference Include="../TinySystem/TinySystem.csproj" />
    <!-- The compiler itself (the self-host implementation) -->
    <ProjectReference Include="../SelfHost/SelfHost.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="CSharpier.Core" Version="1.2.6" />
  </ItemGroup>

  <Import Project="../Transpiler/EmbedReferences.targets" />
</Project>
