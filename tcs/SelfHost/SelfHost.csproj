<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the self-hosted compiler as a .NET library (used by the .NET tcs and the tests).
       The sources are in the tcs subset, and tcs2c converts the same files to C -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>TcsSelf</RootNamespace>
    <!-- Make float stringification culture-independent (same as C and the VM) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tcs host (Tool/: CLI, etc.) has OS functions (TcsHost) per host, so it is not included in the compiler library.
         On .NET, Transpiler builds it together with Transpiler/DotnetHost.cs -->
    <Compile Include="../../src/tcs/Compiler/*.cs" LinkBase="Compiler" />
    <Compile Include="../../src/tcs/CBackend/*.cs" LinkBase="CBackend" />
    <Compile Include="../../src/tcs/VmBackend/*.cs" LinkBase="VmBackend" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TinySystem/TinySystem.csproj" />
  </ItemGroup>

</Project>
